From 1950a9f9d2e2f5d0fc2ea6fe7a38cfead2f55cba Mon Sep 17 00:00:00 2001
From: MG <mateuszGremlik@gmail.com>
Date: Sat, 7 Feb 2026 00:00:00 +0000
Subject: [PATCH] vart: avoid empty-vector copy pattern tripping GCC13

GCC 13 can emit a false-positive -Warray-bounds diagnostic when an empty
std::vector<int> is copied into another by-value API in this code path.

Pass a temporary empty vector directly to the callee to use move semantics
and avoid the problematic copy path.
---
--- a/async-runner/src/batch_tensor_buffer.cpp
+++ b/async-runner/src/batch_tensor_buffer.cpp
@@ -85,7 +85,7 @@ BatchTensorBuffer ::~BatchTensorBuffer() {}
 std::pair<uint64_t, size_t> BatchTensorBuffer::data(
     const std::vector<int> idx) {
   if (idx.empty()) {
-    return tensor_buffers_[0]->data(idx);
+    return tensor_buffers_[0]->data(std::vector<int>{});
   }
   size_t tb_idx = 0u;
   int batch = 0;
