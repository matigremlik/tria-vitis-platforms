 }
-XCL_DRIVER_DLLHIDDEN int xclCloseContext(xclDeviceHandle, const xuid_t, unsigned int) {
-  return 0;
+
+XCL_DRIVER_DLLHIDDEN int xclExecBuf(xclDeviceHandle handle, xclBufferHandle cmdBO) {
+  auto shim = get_shim(handle);
+  return shim ? shim->xclExecBuf(cmdBO) : -1;
 }
-XCL_DRIVER_DLLHIDDEN int xclIPSetReadRange(xclDeviceHandle, uint32_t, uint32_t, uint32_t) {
-  return 0;
+
+XCL_DRIVER_DLLHIDDEN int xclExecWait(xclDeviceHandle handle, int timeoutMilliSec) {
+  auto shim = get_shim(handle);
+  return shim ? shim->xclExecWait(timeoutMilliSec) : -1;
 }
 
 }  // extern "C"
