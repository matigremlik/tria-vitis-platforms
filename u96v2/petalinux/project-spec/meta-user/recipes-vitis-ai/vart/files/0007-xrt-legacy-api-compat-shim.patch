From 3f60218f8d7434e2f47a3b2dd6f1d7f7b1a4a4c2 Mon Sep 17 00:00:00 2001
From: MG <mateuszGremlik@gmail.com>
Date: Mon, 9 Feb 2026 00:00:00 +0000
Subject: [PATCH] vart: provide compat shim for hidden legacy xcl APIs

XRT 2024.2 keeps several legacy xcl* entry points declared in headers but
marks them hidden, so they are not linkable from VART user libraries.

VART 3.5 still calls these APIs from xrt-device-handle. Add a compatibility
source file that provides the expected symbols and forwards to public XRT
APIs where possible, with safe no-op behavior for legacy context helpers.
---
 xrt-device-handle/CMakeLists.txt              |  1 +
 xrt-device-handle/src/xrt_compat_legacy_api.cpp | 90 ++++++++++++++++++++++
 2 files changed, 91 insertions(+)
 create mode 100644 xrt-device-handle/src/xrt_compat_legacy_api.cpp

diff --git a/xrt-device-handle/CMakeLists.txt b/xrt-device-handle/CMakeLists.txt
index 1111111..2222222 100644
--- a/xrt-device-handle/CMakeLists.txt
+++ b/xrt-device-handle/CMakeLists.txt
@@ -30,6 +30,7 @@ add_library(
                     include/xir/xrt_device_handle.hpp src/xrt_device_handle.cpp)
 
 if(XRT_FOUND)
+  target_sources(${COMPONENT_NAME} PRIVATE src/xrt_compat_legacy_api.cpp)
   set(CMAKE_REQUIRED_INCLUDES "${XRT_INCLUDE_DIRS}")
   set(CMAKE_REQUIRED_LIBRARIES "${XRT_CORE_LIBRARIES}")
   include(CheckCXXSourceCompiles)
diff --git a/xrt-device-handle/src/xrt_compat_legacy_api.cpp b/xrt-device-handle/src/xrt_compat_legacy_api.cpp
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/xrt-device-handle/src/xrt_compat_legacy_api.cpp
@@ -0,0 +1,92 @@
