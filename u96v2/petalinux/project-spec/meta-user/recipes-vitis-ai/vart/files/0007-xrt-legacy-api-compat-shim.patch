+#include <xrt.h>
+#include <xrt/xrt_device.h>
+
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+namespace {
+std::mutex g_compat_lock;
+std::unordered_map<xclDeviceHandle, xrtDeviceHandle> g_open_handles;
+}  // namespace
+
+extern "C" {
+
+XCL_DRIVER_DLLHIDDEN unsigned int xclProbe() {
+  constexpr unsigned int kMaxDevices = 64u;
+  unsigned int count = 0u;
+  for (unsigned int i = 0u; i < kMaxDevices; ++i) {
+    auto dh = xrtDeviceOpen(i);
+    if (!dh) {
+      break;
+    }
+    ++count;
+    (void)xrtDeviceClose(dh);
+  }
+  return count;
+}
+
+XCL_DRIVER_DLLHIDDEN xclDeviceHandle xclOpen(
+    unsigned int deviceIndex, const char* unused1, enum xclVerbosityLevel unused2) {
+  (void)unused1;
+  (void)unused2;
+  auto dh = xrtDeviceOpen(deviceIndex);
+  if (!dh) {
+    return nullptr;
+  }
+  auto xh = xrtDeviceToXclDevice(dh);
+  if (!xh) {
+    (void)xrtDeviceClose(dh);
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> guard(g_compat_lock);
+  g_open_handles[xh] = dh;
+  return xh;
+}
+
+XCL_DRIVER_DLLHIDDEN void xclClose(xclDeviceHandle handle) {
+  xrtDeviceHandle dh = nullptr;
+  {
+    std::lock_guard<std::mutex> guard(g_compat_lock);
+    auto it = g_open_handles.find(handle);
+    if (it != g_open_handles.end()) {
+      dh = it->second;
+      g_open_handles.erase(it);
+    }
+  }
+  if (!dh && handle) {
+    dh = xrtDeviceOpenFromXcl(handle);
+  }
+  if (dh) {
+    (void)xrtDeviceClose(dh);
+  }
+}
+
+XCL_DRIVER_DLLHIDDEN int xclGetDeviceInfo2(xclDeviceHandle, struct xclDeviceInfo2* info) {
+  if (!info) {
+    return -1;
+  }
+  std::memset(info, 0, sizeof(*info));
+  info->mMagic = 0x586C0C6C;
+  std::strncpy(info->mName, "xrt", sizeof(info->mName) - 1);
+  return 0;
+}
+
+XCL_DRIVER_DLLHIDDEN int xclOpenContext(xclDeviceHandle, const xuid_t, unsigned int, bool) { return 0; }
+XCL_DRIVER_DLLHIDDEN int xclCloseContext(xclDeviceHandle, const xuid_t, unsigned int) { return 0; }
+XCL_DRIVER_DLLHIDDEN int xclIPSetReadRange(xclDeviceHandle, uint32_t, uint32_t, uint32_t) { return 0; }
+
+}  // extern "C"
