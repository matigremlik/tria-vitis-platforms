--- a/dpuinfer/meson.build
+++ b/dpuinfer/meson.build
@@ -246,6 +246,35 @@ else
 endif
 
 protobuf_dep = cc.find_library('protobuf')
+
+# protobuf 4.x may require absl log/check symbols at link time.
+# Link commonly required absl components when available.
+absl_dep = []
+foreach absl_lib : [
+  'absl_log_internal_check_op',
+  'absl_log_internal_message',
+  'absl_log_internal_format',
+  'absl_log_internal_nullguard',
+  'absl_log_internal_conditions',
+  'absl_log_globals',
+  'absl_log_severity',
+  'absl_log_sink',
+  'absl_log_entry',
+  'absl_log_flags',
+  'absl_strings',
+  'absl_strings_internal',
+  'absl_string_view',
+  'absl_base',
+  'absl_throw_delegate',
+  'absl_raw_logging_internal',
+  'absl_int128',
+]
+  dep = cc.find_library(absl_lib, required: false)
+  if dep.found()
+    absl_dep += dep
+  endif
+endforeach
+
 glog_dep = cc.find_library('glog')
 jansson_dep = dependency('jansson', version : '>= 2.7', required: true)
 opencv_dep = dependency('opencv4', version : '>=4.2.0', required: false)
